          },
          {
            "type": "numbered_list_item",
            "numbered_list_item": {
              "rich_text": [
                { "type": "text", "text": { "content": "Spark" }, "annotations": { "bold": true } },
                { "type": "text", "text": { "content": " — Capture the idea in one sentence. Tag it. Leave the rest unfinished." } }
              ]
            }
          },
          {
            "type": "numbered_list_item",
            "numbered_list_item": {
              "rich_text": [
                { "type": "text", "text": { "content": "Explore" }, "annotations": { "bold": true } },
                { "type": "text", "text": { "content": " — Read, sketch, and attach research. Decide if it is worth a real test." } }
              ]
            }
          },
          {
            "type": "numbered_list_item",
            "numbered_list_item": {
              "rich_text": [
                { "type": "text", "text": { "content": "Validate" }, "annotations": { "bold": true } },
                { "type": "text", "text": { "content": " — Write a hypothesis and open an experiment with a start and end date." } }
              ]
            }
          },
          {
            "type": "numbered_list_item",
            "numbered_list_item": {
              "rich_text": [
                { "type": "text", "text": { "content": "Build" }, "annotations": { "bold": true } },
                { "type": "text", "text": { "content": " — Run the experiment. Keep learnings in the same row, not in a side chat." } }
              ]
            }
          },
          {
            "type": "numbered_list_item",
            "numbered_list_item": {
              "rich_text": [
